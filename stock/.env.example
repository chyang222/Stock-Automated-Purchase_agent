# ============================================================
#  .env.example — 이 파일을 .env로 복사하고 값을 채워주세요
#  cp .env.example .env
# ============================================================

# Anthropic (Claude API)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude 모델 (기본값: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================
#  KIS (한국투자증권) OpenAPI
#  https://apiportal.koreainvestment.com
# ============================================================
KIS_APP_KEY=발급받은_앱키
KIS_APP_SECRET=발급받은_앱시크릿

# 계좌번호 형식: "12345678-01" (계좌번호-계좌상품코드)
KIS_ACCOUNT_NO=12345678-01

# 모의투자 여부 (true=모의, false=실전)
KIS_IS_PAPER=true

# ============================================================
#  매매 설정
# ============================================================

# 감시 종목 코드 (콤마 구분)
# 005930=삼성전자, 000660=SK하이닉스, 035420=NAVER, 051910=LG화학
WATCH_LIST=005930,000660

# 종목당 최대 주문 수량
TRADE_QUANTITY=1

# DRY_RUN=true 이면 실제 주문 없이 시뮬레이션만 실행
DRY_RUN=true
